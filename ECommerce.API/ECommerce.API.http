@ECommerce_API_HostAddress = https://localhost:44347

### Get all categories
GET {{ECommerce_API_HostAddress}}/api/categories
Accept: application/json

###

### Get category by ID
GET {{ECommerce_API_HostAddress}}/api/categories/1
Accept: application/json

###

### Create category
POST {{ECommerce_API_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic devices and accessories"
}

### Create Category

POST {{ECommerce_API_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic devices and accessories"
}

### Create Product

POST {{ECommerce_API_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Gaming Laptop",
  "description": "High performance gaming laptop",
  "price": 250000,
  "stockQuantity": 10,
  "imageUrl": "https://example.com/laptop.jpg",
  "categoryId": 1
}


### Get Products

GET {{ECommerce_API_HostAddress}}/api/products
Accept: application/json

### Register

POST {{ECommerce_API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Mubasher",
  "lastName": "Developer",
  "email": "mubasher@example.com",
  "password": "Password123!"
}

### Login

POST {{ECommerce_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "mubasher@example.com",
  "password": "Password123!"
}

### Public endpoint

GET {{ECommerce_API_HostAddress}}/api/test/public

### Protected endpoint

GET {{ECommerce_API_HostAddress}}/api/test/protected

